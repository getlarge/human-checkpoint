{
  "name": "@human-checkpoint/node-red",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/nodes.js",
  "types": "./dist/nodes.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "node-red": {
    "nodes": {
      "human-checkpoint": "dist/nodes.js"
    }
  },
  "scripts": {
    "build": "tsc -b && cp human-checkpoint.html dist/nodes.html",
    "test": "vitest run",
    "typecheck": "tsc -b --emitDeclarationOnly"
  },
  "dependencies": {
    "@human-checkpoint/core": "workspace:*",
    "@human-checkpoint/store": "workspace:*",
    "@themoltnet/sdk": "0.128.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
